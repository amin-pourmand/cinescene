# Optional: keep model downloads, caches and upload temporary files off the OS drive.
# On this machine, models/ and data/ are junctions into this directory.
# CINESCENE_STORAGE_ROOT=E:\CineSceneCache\cinescene
# Bounded offline-translation cold-start deadline (30..300 seconds); memory limits stay unchanged.
# CINESCENE_TRANSLATION_TIMEOUT_SEC=150
# Optional prepared reranker override; the selected model is reported in diagnostics.
# CINESCENE_RERANKER_MODEL=BAAI/bge-reranker-base
# Hybrid BGE/BM25 retrieval, E5-base for Persian, and MiniLM reranking.
CINESCENE_SEARCH_ENGINE=hybrid
CINESCENE_MODEL_RUNTIME=onnx
CINESCENE_CPU_THREADS=2
# One short-lived inference process at a time, with a Windows job memory cap.
CINESCENE_ISOLATE_INFERENCE=1
CINESCENE_WORKER_MEMORY_MB=1536
CINESCENE_MEDIA_WORKER_MEMORY_MB=3072
CINESCENE_MIN_SYSTEM_FREE_GB=3
CINESCENE_RAM_RESERVE_MB=384
# Optional offline FA->EN query/evidence translator; prepare_query_translation.py.
# Queries never leave this machine. NLLB weights are CC-BY-NC-4.0.
CINESCENE_QUERY_TRANSLATION=1
